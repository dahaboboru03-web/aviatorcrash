# Daraja (Safaricom M-Pesa) - placeholders only. Do not commit real credentials.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=
DARAJA_CALLBACK_URL=
DARAJA_RESULT_URL=
DARAJA_TIMEOUT_URL=

# Keep false until credentials are configured and regulatory/production requirements are met.
DARAJA_ENABLED=false

# Payment limits (KSh)
MIN_WITHDRAWAL=50
MAX_WITHDRAWAL=70000

# Public HTTPS base URL for callbacks (Safaricom cannot reach localhost).
# Example when using a tunnel or deployed host: https://your-public-host.example
PUBLIC_BASE_URL=
